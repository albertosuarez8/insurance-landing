# Formspree: form submissions are emailed to the address you set in the Formspree dashboard.
# Get your endpoint at https://formspree.io/ (New form → set notification email to albertosivoli@outlook.com).
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID
REACT_APP_FORMSPREE_HOMEOWNERS_ENDPOINT=https://formspree.io/f/YOUR_HOMEOWNERS_FORM_ID
